# Copy to .env and fill in from your Supabase dashboard:
#   Project Settings -> API
#
# Both of these are safe to expose. Vite inlines every VITE_ variable into the
# bundle, so they end up public on GitHub Pages and inside the Android APK
# either way - which is fine, because the anon key grants nothing on its own.
# Row Level Security is what protects the data.
#
# NEVER put the service_role key here, or in any VITE_ variable. It bypasses
# RLS completely.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
