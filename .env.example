# Copy to .env and fill in from your Supabase dashboard:
#   Project Settings -> API
#
# Both of these are safe to expose. Vite inlines every VITE_ variable into the
# bundle, so they end up public on GitHub Pages and inside the Android APK
# either way - which is fine, because the anon key grants nothing on its own.
# Row Level Security is what protects the data.
#
# NEVER put the service_role key here, or in any VITE_ variable. It bypasses
# RLS completely.

# The dashboard calls this the "anon / public" key on older projects and the
# "publishable" key (sb_publishable_...) on newer ones. Either goes here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# hCaptcha site key. Public by design - it is handed to the browser so the
# widget can render. Required only if captcha protection is enabled in the
# Supabase dashboard; with it unset the forms show no captcha and send no
# token, which is correct for a project that has captcha turned off.
#
# The hCaptcha SECRET key is a different value. It goes in the Supabase
# dashboard only, and must never appear here or in any VITE_ variable.
VITE_HCAPTCHA_SITE_KEY=
